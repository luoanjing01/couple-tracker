# ============================================================
# Vercel 部署配置 —— 情侣报备 前端 Web（React + Vite）
# 免费版静态托管 + SPA 路由回退
# https://vercel.com/docs/configuration
# ============================================================

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://YOUR-RENDER-API.onrender.com/api/:path*"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "https://YOUR-RENDER-API.onrender.com/socket.io/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
